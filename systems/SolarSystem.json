{
  "$schema": "https://raw.githubusercontent.com/Outer-Wilds-New-Horizons/new-horizons/main/NewHorizons/Schemas/star_system_schema.json",
  "conditionalChecks": [
    {
      "check": { "allPersistentConditionsSet": [ "GITM_STATUE_PLAYER" ] },
      "then": {
        "setConditions": [ "GITM_TerribleFate" ],
        "reversible": true
      }
    },
    {
      "check": {
        "allPersistentConditionsSet": [ "GITM_MASK_INSTALLED" ],
        "allConditionsSet": [ "GITM_StatueInstalledThisLoop" ]
      },
      "then": {
        "setConditions": [ "GITM_GameOver" ],
        "reversible": true
      }
    },
    {
      "check": { "allFactsRevealed": [ "GITM_MEMORY_CLASSROOM_REVEAL" ] },
      "then": {
        "revealFacts": [ "GITM_GHOST_CLIMB_HINT_RUMOR" ]
      }
    },
    {
      "check": {
        "allPersistentConditionsSet": [
          "GITM_STATUE_FORGE",
          "GITM_STATUE_ATP"
        ]
      },
      "then": {
        "revealFacts": [ "GITM_CHOICE_MORE_RUMOR" ]
      }
    },
    {
      "check": { "allFactsRevealed": [ "GITM_MEMORY_FOSSIL_REVEAL" ] },
      "then": {
        "revealFacts": [ "GITM_GHOST_LAEVI_RUMOR" ]
      }
    },
    {
      "check": {
        "allFactsRevealed": [
          "GITM_MEMORY_FOSSIL_REVEAL",
          "GITM_VISION_SS_UPPER_REVIEW"
        ]
      },
      "then": {
        "revealFacts": [ "GITM_GHOST_AUNT_PYE_RUMOR" ]
      }
    },
    {
      "check": {
        "allPersistentConditionsSet": [
          "GITM_STATUE_GABBRO",
          "GITM_STATUE_WORKSHOP",
          "GITM_STATUE_PROBE",
          "GITM_STATUE_FORGE",
          "GITM_STATUE_ATP",
          "GITM_STATUE_SS_UPPER",
          "GITM_STATUE_SS_LOWER"
        ],
        "allFactsRevealed": [
          "GITM_MEMORY_CLASSROOM_REVEAL",
          "GITM_MEMORY_FOSSIL_REVEAL",
          "GITM_MEMORY_HOME_REVEAL"
        ]
      },
      "then": {
        "revealFacts": [ "GITM_GHOST_MASK_RUMOR" ]
      }
    },
    {
      "check": { "allFactsRevealed": [ "GITM_FIND_MASK_REVEAL" ] },
      "then": {
        "revealFacts": [ "GITM_GHOST_SOLANUM_RUMOR" ]
      }
    },
    {
      "check": { "allPersistentConditionsSet": [ "GITM_MASK_INSTALLED" ] },
      "then": {
        "revealFacts": [ "GITM_GHOST_CURIOSITY_REVEAL" ]
      }
    }
  ],
